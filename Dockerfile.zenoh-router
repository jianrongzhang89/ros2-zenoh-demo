# Download the glibc-linked (linux-gnu) zenohd from GitHub releases.
# The *-standalone.zip bundles zenohd + REST and storage-manager plugins
# with no external runtime deps beyond standard glibc — compatible with UBI9.
#
# TARGETARCH is set automatically by podman/buildah --platform (values: amd64, arm64).
# It is mapped to the Rust target triple used in the GitHub release filename.
ARG ECLIPSE_TAG=1.9.0

FROM registry.access.redhat.com/ubi9/ubi-minimal

ARG ECLIPSE_TAG
ARG TARGETARCH=amd64

# nmap-ncat provides 'nc -z' used by init containers for TCP readiness checks.
# shadow-utils is only needed for useradd; unzip for extracting the release zip.
# Both are removed after use to keep the image minimal.
RUN microdnf install -y shadow-utils nmap-ncat unzip && \
    useradd -m -u 1001 -g 0 -s /bin/bash zenoh && \
    chmod -R g=u /home/zenoh && \
    case "${TARGETARCH}" in \
      amd64) RUST_TARGET="x86_64-unknown-linux-gnu"  ;; \
      arm64) RUST_TARGET="aarch64-unknown-linux-gnu" ;; \
      *)     echo "Unsupported TARGETARCH: ${TARGETARCH}" && exit 1 ;; \
    esac && \
    curl -fsSL \
      "https://github.com/eclipse-zenoh/zenoh/releases/download/${ECLIPSE_TAG}/zenoh-${ECLIPSE_TAG}-${RUST_TARGET}-standalone.zip" \
      -o /tmp/zenoh.zip && \
    mkdir -p /opt/zenoh && \
    unzip /tmp/zenoh.zip -d /opt/zenoh/ && \
    chmod +x /opt/zenoh/zenohd && \
    rm /tmp/zenoh.zip && \
    microdnf remove -y shadow-utils unzip && \
    microdnf clean all

ENV HOME=/home/zenoh

# Non-root UID 1001 with GID 0 satisfies OpenShift restricted-v2 SCC:
# runAsNonRoot=true passes, and GID 0 ensures file access under arbitrary UIDs.
USER 1001

# 7447: Zenoh session endpoint   8000: REST API (served by libzenoh_plugin_rest.so)
EXPOSE 7447 8000
# Invoke from /opt/zenoh so zenohd finds its plugins in the same directory.
ENTRYPOINT ["/opt/zenoh/zenohd"]

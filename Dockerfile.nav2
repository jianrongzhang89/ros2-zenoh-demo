FROM ros:jazzy-ros-core

# Install ROS 2 Navigation Stack (Nav2) + Python Simple Commander
# Install Nav2 + rmw_zenoh_cpp (native Zenoh RMW).
# Using rmw_zenoh_cpp avoids the CycloneDDS version mismatch between the
# zenoh-bridge-ros2dds bundled CycloneDDS and the system package, which
# causes "Bad Parameter" DDS writer errors in the Zenoh→DDS relay path.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-navigation2 \
        ros-jazzy-nav2-bringup \
        ros-jazzy-nav2-simple-commander \
        ros-jazzy-rmw-zenoh-cpp \
        python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# OpenShift restricted-v2 SCC: non-root UID with GID=0 (root group)
# so files remain accessible when OpenShift assigns an arbitrary UID at runtime.
RUN useradd -m -u 1001 -g 0 -s /bin/bash ros && \
    chmod -R g=u /home/ros

ENV HOME=/home/ros

# Zenoh session config: client mode connecting to zenoh-router Service.
# rmw_zenoh_cpp reads this when RMW_IMPLEMENTATION=rmw_zenoh_cpp is set.
COPY --chown=1001:0 zenoh-client.json5 /zenoh-client.json5

USER 1001

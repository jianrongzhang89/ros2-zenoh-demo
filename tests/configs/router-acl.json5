{
  // Scenario 8: router ACL — independent filtering layer from the bridge.
  // Bridge uses bridge-baseline.json5 (no filter) so all topics enter Zenoh.
  // Router ACL denies rt/sensor/** at egress regardless of what the bridge allows.
  //
  // Zenoh key mapping for zenoh-bridge-ros2dds v1.9.0 (no namespace):
  //   DDS /sensor/scan   → Zenoh sensor/scan
  //   DDS /sensor/camera → Zenoh sensor/camera
  //   DDS /chatter       → Zenoh chatter
  // Note: the "rt/" prefix documented in older zenoh-plugin-dds research does NOT
  // apply to zenoh-bridge-ros2dds v1.9.0; keys use the bare topic name.
  //
  // Zenoh 1.9.0 ACL requires all three arrays: rules + subjects + policies.
  // An empty subjects entry (no filter fields) is a wildcard matching all connections.
  //
  // ACL priority: explicit deny > explicit allow > default_permission.
  mode: "router",
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"]
  },
  scouting: {
    multicast: { enabled: false }
  },
  adminspace: {
    enabled: true,
    permissions: {
      read:  true,
      write: false
    }
  },
  plugins: {
    rest: {
      __required__: false,
      http_port: "8000"
    }
  },
  access_control: {
    enabled: true,
    default_permission: "allow",
    rules: [
      {
        id: "block-sensor-egress",
        messages: ["put", "declare_subscriber"],
        flows: ["egress"],
        permission: "deny",
        key_exprs: ["sensor/**"]
      }
    ],
    subjects: [
      {
        id: "all-clients"
        // no filter fields = wildcard, matches every connection
      }
    ],
    policies: [
      {
        rules:    ["block-sensor-egress"],
        subjects: ["all-clients"]
      }
    ]
  }
}

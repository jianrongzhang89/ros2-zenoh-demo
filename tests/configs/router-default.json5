{
  // Default router config: no ACL.
  // Used by Scenarios 1–7.
  // adminspace + rest plugin enabled for Scenario 6 Zenoh key inspection.
  // rest is __required__: false — the router starts normally even if the plugin
  // is absent in the image; port 8000 may simply not respond.
  mode: "router",
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"]
  },
  scouting: {
    multicast: { enabled: false }
  },
  adminspace: {
    enabled: true,
    permissions: {
      read:  true,
      write: false
    }
  },
  plugins: {
    rest: {
      __required__: false,
      http_port: "8000"
    }
  }
}
